# Optional integrations. Leave these empty for the fully local mocked demo.
# When DATABASE_URL is empty, the Coordinator uses embedded PGlite in .data/.
DATABASE_URL=
# Optional Neon AI Gateway settings. When empty, voice intent uses the local keyword interpreter.
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
COORDINATOR_MODEL=claude-haiku-4-5
# Optional direct model fallback. Leave empty for local development.
ANTHROPIC_API_KEY=
DISABLE_LLM=1
PORT=8787
